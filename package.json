{
  "name": "dw-manager",
  "displayName": "DW Manager",
  "description": "Manage Salesforce Commerce Cloud Environments and Sites, combine their configuration, browse cartridges, and tail logs.",
  "version": "2.0.0",
  "publisher": "Ferb",
  "repository": {
    "type": "git",
    "url": "https://github.com/phat-trann/dw-manager"
  },
  "license": "MIT",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "keywords": [
    "salesforce",
    "environment",
    "manager",
    "dw",
    "credentials",
    "developer",
    "commerce cloud",
    "sites"
  ],
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "onView:dwManagerEnvironmentsView",
    "onView:dwManagerSitesView",
    "onView:dwManagerCartridgesView",
    "onView:dwManagerLogsView",
    "onCommand:dw-manager.selectEnvironment",
    "onCommand:dw-manager.selectSite",
    "onCommand:dw-manager.createEnvironment",
    "onCommand:dw-manager.createSite",
    "onCommand:dw-manager.editEnvironment",
    "onCommand:dw-manager.editSite",
    "onCommand:dw-manager.deleteEnvironment",
    "onCommand:dw-manager.deleteSite",
    "onCommand:dw-manager.changeCartridges",
    "onCommand:dw-manager.refreshConfiguration",
    "onCommand:dw-manager.exportSetup",
    "onCommand:dw-manager.importSetup",
    "onCommand:dw-manager.enableProphetUpload",
    "onCommand:dw-manager.disableProphetUpload",
    "onCommand:dw-manager.refreshCartridges",
    "onCommand:dw-manager.openCartridge",
    "onCommand:dw-manager.revealCartridgeInExplorer",
    "onCommand:dw-manager.refreshLogs",
    "onCommand:dw-manager.tailLog",
    "onCommand:dw-manager.stopTailingLog"
  ],
  "contributes": {
    "menus": {
      "view/title": [
        {
          "command": "dw-manager.createEnvironment",
          "when": "view == dwManagerEnvironmentsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.createSite",
          "when": "view == dwManagerSitesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshCartridges",
          "when": "view == dwManagerCartridgesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshLogs",
          "when": "view == dwManagerLogsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshConfiguration",
          "when": "view == dwManagerEnvironmentsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshConfiguration",
          "when": "view == dwManagerSitesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dw-manager.editEnvironment",
          "when": "viewItem == environment",
          "group": "inline"
        },
        {
          "command": "dw-manager.deleteEnvironment",
          "when": "viewItem == environment",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.editSite",
          "when": "viewItem == site",
          "group": "inline"
        },
        {
          "command": "dw-manager.deleteSite",
          "when": "viewItem == site",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.changeCartridges",
          "when": "viewItem == site",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.openCartridge",
          "when": "view == dwManagerCartridgesView && viewItem == cartridge",
          "group": "inline"
        },
        {
          "command": "dw-manager.revealCartridgeInExplorer",
          "when": "view == dwManagerCartridgesView && viewItem == cartridge",
          "group": "2_open"
        },
        {
          "command": "dw-manager.stopTailingLog",
          "when": "view == dwManagerLogsView && viewItem == logFileTailing",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "dw-manager.editEnvironment",
          "when": "false"
        },
        {
          "command": "dw-manager.editSite",
          "when": "false"
        },
        {
          "command": "dw-manager.deleteEnvironment",
          "when": "false"
        },
        {
          "command": "dw-manager.deleteSite",
          "when": "false"
        },
        {
          "command": "dw-manager.changeCartridges",
          "when": "false"
        },
        {
          "command": "dw-manager.openCartridge",
          "when": "false"
        },
        {
          "command": "dw-manager.revealCartridgeInExplorer",
          "when": "false"
        },
        {
          "command": "dw-manager.tailLog",
          "when": "false"
        },
        {
          "command": "dw-manager.stopTailingLog",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dwManager",
          "title": "DW Manager",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "dwManager": [
        {
          "id": "dwManagerEnvironmentsView",
          "name": "Environments"
        },
        {
          "id": "dwManagerSitesView",
          "name": "Sites"
        },
        {
          "id": "dwManagerCartridgesView",
          "name": "Cartridges"
        },
        {
          "id": "dwManagerLogsView",
          "name": "Logs"
        }
      ]
    },
    "commands": [
      {
        "command": "dw-manager.selectEnvironment",
        "title": "Select Environment"
      },
      {
        "command": "dw-manager.selectSite",
        "title": "Select Site"
      },
      {
        "command": "dw-manager.createEnvironment",
        "title": "Create Environment",
        "icon": "$(add)"
      },
      {
        "command": "dw-manager.createSite",
        "title": "Create Site",
        "icon": "$(add)"
      },
      {
        "command": "dw-manager.editEnvironment",
        "title": "Edit Environment"
      },
      {
        "command": "dw-manager.editSite",
        "title": "Edit Site"
      },
      {
        "command": "dw-manager.deleteEnvironment",
        "title": "Delete Environment"
      },
      {
        "command": "dw-manager.deleteSite",
        "title": "Delete Site"
      },
      {
        "command": "dw-manager.changeCartridges",
        "title": "Change Site Cartridges"
      },
      {
        "command": "dw-manager.refreshConfiguration",
        "title": "Refresh Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.exportSetup",
        "title": "Export DW Manager Setup"
      },
      {
        "command": "dw-manager.importSetup",
        "title": "Import DW Manager Setup"
      },
      {
        "command": "dw-manager.enableProphetUpload",
        "title": "DW Manager: Enable Upload (Prophet)"
      },
      {
        "command": "dw-manager.disableProphetUpload",
        "title": "DW Manager: Disable Upload (Prophet)"
      },
      {
        "command": "dw-manager.refreshCartridges",
        "title": "Refresh Cartridges",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.openCartridge",
        "title": "Open Cartridge"
      },
      {
        "command": "dw-manager.revealCartridgeInExplorer",
        "title": "Reveal Cartridge in Explorer"
      },
      {
        "command": "dw-manager.refreshLogs",
        "title": "Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.tailLog",
        "title": "Tail Log"
      },
      {
        "command": "dw-manager.stopTailingLog",
        "title": "Stop Tailing"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --outfile=out/extension.js --external:vscode --external:@aws-sdk/client-s3",
    "test": "vitest run",
    "build:vsix": "node scripts/build-vsix.mjs",
    "build": "npm run build:vsix"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "unzipper": "^0.12.3"
  }
}
