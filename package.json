{
  "name": "dw-manager",
  "displayName": "DW Manager",
  "description": "Manage Commerce Cloud Environments and Sites, watch/upload cartridges, debug with Prophet, browse Impex, and tail logs.",
  "version": "2.8.4",
  "publisher": "Ferb",
  "repository": {
    "type": "git",
    "url": "https://github.com/phat-trann/dw-manager"
  },
  "license": "MIT",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "keywords": [
    "salesforce",
    "environment",
    "manager",
    "dw",
    "credentials",
    "developer",
    "commerce cloud",
    "sites"
  ],
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:dwManagerEnvironmentsView",
    "onView:dwManagerSitesView",
    "onView:dwManagerLogsView",
    "onCommand:dw-manager.selectEnvironment",
    "onCommand:dw-manager.selectSite",
    "onCommand:dw-manager.createEnvironment",
    "onCommand:dw-manager.createSite",
    "onCommand:dw-manager.editEnvironment",
    "onCommand:dw-manager.editSite",
    "onCommand:dw-manager.deleteEnvironment",
    "onCommand:dw-manager.deleteSite",
    "onCommand:dw-manager.changeCartridges",
    "onCommand:dw-manager.refreshConfiguration",
    "onCommand:dw-manager.exportSetup",
    "onCommand:dw-manager.importSetup",
    "onCommand:dw-manager.enableProphetUpload",
    "onCommand:dw-manager.disableProphetUpload",
    "onCommand:dw-manager.refreshCartridges",
    "onCommand:dw-manager.openCartridge",
    "onCommand:dw-manager.revealCartridgeInExplorer",
    "onCommand:dw-manager.refreshLogs",
    "onCommand:dw-manager.tailLog",
    "onCommand:dw-manager.stopTailingLog",
    "onView:dwManagerImpexView",
    "onCommand:dw-manager.startDebugging",
    "onCommand:dw-manager.refreshImpex",
    "onCommand:dw-manager.openImpexFile",
    "onCommand:dw-manager.repos.preview",
    "onCommand:dw-manager.repos.git",
    "onCommand:dw-manager.repos.install",
    "onCommand:dw-manager.repos.reinstall",
    "onCommand:dw-manager.repos.compile",
    "onCommand:dw-manager.repos.scss",
    "onCommand:dw-manager.repos.js",
    "onCommand:dw-manager.repos.install-compile",
    "onCommand:dw-manager.repos.all",
    "onCommand:dw-manager.repos.changed",
    "onCommand:dw-manager.repos.configure",
    "onCommand:dw-manager.repos.state",
    "onView:dwManagerActivitiesView",
    "onCommand:dw-manager.activities.start",
    "onCommand:dw-manager.activities.stop",
    "onCommand:dw-manager.activities.refresh",
    "onCommand:dw-manager.activities.clearFinished",
    "onCommand:dw-manager.activities.show",
    "onCommand:dw-manager.enableUploadAll",
    "onCommand:dw-manager.enableSelectedUpload",
    "onCommand:dw-manager.enableSelectedUploadAll",
    "onCommand:dw-manager.showUploadOutput"
  ],
  "contributes": {
    "menus": {
      "view/title": [
        {
          "command": "dw-manager.createEnvironment",
          "when": "view == dwManagerEnvironmentsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.createSite",
          "when": "view == dwManagerSitesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshLogs",
          "when": "view == dwManagerLogsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshConfiguration",
          "when": "view == dwManagerEnvironmentsView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshConfiguration",
          "when": "view == dwManagerSitesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.startDebugging",
          "when": "view == dwManagerSitesView",
          "group": "navigation@3"
        },
        {
          "command": "dw-manager.refreshImpex",
          "when": "view == dwManagerImpexView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.activities.refresh",
          "when": "view == dwManagerActivitiesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.activities.clearFinished",
          "when": "view == dwManagerActivitiesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.activities.show",
          "when": "view == dwManagerSitesView",
          "group": "5_activity"
        },
        {
          "command": "dw-manager.activities.show",
          "when": "view == dwManagerEnvironmentsView",
          "group": "5_activity"
        },
        {
          "command": "dw-manager.showUploadOutput",
          "when": "view == dwManagerActivitiesView",
          "group": "2_output@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dw-manager.editEnvironment",
          "when": "viewItem == environment",
          "group": "inline"
        },
        {
          "command": "dw-manager.deleteEnvironment",
          "when": "viewItem == environment",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.editSite",
          "when": "viewItem == site",
          "group": "inline"
        },
        {
          "command": "dw-manager.deleteSite",
          "when": "viewItem == site",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.changeCartridges",
          "when": "viewItem == site",
          "group": "2_edit"
        },
        {
          "command": "dw-manager.stopTailingLog",
          "when": "view == dwManagerLogsView && viewItem == logFileTailing",
          "group": "inline"
        },
        {
          "submenu": "dw-manager.siteActions",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "inline@2"
        },
        {
          "submenu": "dw-manager.repoActions",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "inline@3"
        },
        {
          "command": "dw-manager.activities.stop",
          "when": "view == dwManagerActivitiesView && viewItem =~ /^(activityUploadOn|activityPending|activityDebugRunning|activityTaskRunning)$/",
          "group": "inline@1"
        },
        {
          "command": "dw-manager.activities.start",
          "when": "view == dwManagerActivitiesView && viewItem =~ /^(activityUploadOff|activityTaskStopped)$/",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dw-manager.editEnvironment",
          "when": "false"
        },
        {
          "command": "dw-manager.editSite",
          "when": "false"
        },
        {
          "command": "dw-manager.deleteEnvironment",
          "when": "false"
        },
        {
          "command": "dw-manager.deleteSite",
          "when": "false"
        },
        {
          "command": "dw-manager.changeCartridges",
          "when": "false"
        },
        {
          "command": "dw-manager.tailLog",
          "when": "false"
        },
        {
          "command": "dw-manager.stopTailingLog",
          "when": "false"
        },
        {
          "command": "dw-manager.openImpexFile",
          "when": "false"
        },
        {
          "command": "dw-manager.activities.start",
          "when": "false"
        },
        {
          "command": "dw-manager.activities.stop",
          "when": "false"
        }
      ],
      "dw-manager.siteActions": [
        {
          "command": "dw-manager.startDebugging",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "0_debug@1"
        },
        {
          "command": "dw-manager.enableProphetUpload",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_upload@1"
        },
        {
          "command": "dw-manager.disableProphetUpload",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_upload@2"
        },
        {
          "command": "dw-manager.enableUploadAll",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_upload@6"
        },
        {
          "command": "dw-manager.enableSelectedUpload",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_upload@7"
        },
        {
          "command": "dw-manager.enableSelectedUploadAll",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_upload@8"
        },
        {
          "command": "dw-manager.showUploadOutput",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "2_output@1"
        }
      ],
      "dw-manager.repoActions": [
        {
          "command": "dw-manager.repos.preview",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "0_preview@0"
        },
        {
          "command": "dw-manager.repos.git",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@1"
        },
        {
          "command": "dw-manager.repos.install",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@2"
        },
        {
          "command": "dw-manager.repos.reinstall",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@3"
        },
        {
          "command": "dw-manager.repos.compile",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@4"
        },
        {
          "command": "dw-manager.repos.scss",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@5"
        },
        {
          "command": "dw-manager.repos.js",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@6"
        },
        {
          "command": "dw-manager.repos.install-compile",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@7"
        },
        {
          "command": "dw-manager.repos.all",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@8"
        },
        {
          "command": "dw-manager.repos.changed",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "1_run@9"
        },
        {
          "command": "dw-manager.repos.configure",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "2_settings@10"
        },
        {
          "command": "dw-manager.repos.state",
          "when": "view == dwManagerSitesView && viewItem == site",
          "group": "2_settings@11"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dwManager",
          "title": "DW Manager",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "dwManager": [
        {
          "id": "dwManagerEnvironmentsView",
          "name": "Environments"
        },
        {
          "id": "dwManagerSitesView",
          "name": "Sites"
        },
        {
          "id": "dwManagerActivitiesView",
          "name": "Activities",
          "visibility": "visible"
        },
        {
          "id": "dwManagerLogsView",
          "name": "Logs"
        },
        {
          "id": "dwManagerImpexView",
          "name": "Impex"
        }
      ]
    },
    "commands": [
      {
        "command": "dw-manager.selectEnvironment",
        "title": "Select Environment"
      },
      {
        "command": "dw-manager.selectSite",
        "title": "Select Site"
      },
      {
        "command": "dw-manager.createEnvironment",
        "title": "Create Environment",
        "icon": "$(add)"
      },
      {
        "command": "dw-manager.createSite",
        "title": "Create Site",
        "icon": "$(add)"
      },
      {
        "command": "dw-manager.editEnvironment",
        "title": "Edit Environment"
      },
      {
        "command": "dw-manager.editSite",
        "title": "Edit Site"
      },
      {
        "command": "dw-manager.deleteEnvironment",
        "title": "Delete Environment"
      },
      {
        "command": "dw-manager.deleteSite",
        "title": "Delete Site"
      },
      {
        "command": "dw-manager.changeCartridges",
        "title": "Change Site Cartridges"
      },
      {
        "command": "dw-manager.refreshConfiguration",
        "title": "Refresh Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.exportSetup",
        "title": "Export DW Manager Setup"
      },
      {
        "command": "dw-manager.importSetup",
        "title": "Import DW Manager Setup"
      },
      {
        "command": "dw-manager.enableProphetUpload",
        "title": "DW Manager: Enable Upload (Watch Changes Only)"
      },
      {
        "command": "dw-manager.disableProphetUpload",
        "title": "DW Manager: Disable Upload"
      },
      {
        "command": "dw-manager.refreshCartridges",
        "title": "Refresh Cartridges",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.openCartridge",
        "title": "Open Cartridge"
      },
      {
        "command": "dw-manager.revealCartridgeInExplorer",
        "title": "Reveal Cartridge in Explorer"
      },
      {
        "command": "dw-manager.refreshLogs",
        "title": "Refresh Logs",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.tailLog",
        "title": "Tail Log"
      },
      {
        "command": "dw-manager.stopTailingLog",
        "title": "Stop Tailing"
      },
      {
        "command": "dw-manager.startDebugging",
        "title": "Start Debugging",
        "icon": "$(debug-start)"
      },
      {
        "command": "dw-manager.refreshImpex",
        "title": "Refresh Impex",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.openImpexFile",
        "title": "Open Impex File"
      },
      {
        "command": "dw-manager.repos.preview",
        "title": "Preview Site Repositories"
      },
      {
        "command": "dw-manager.repos.git",
        "title": "Git Reset All"
      },
      {
        "command": "dw-manager.repos.install",
        "title": "Install All"
      },
      {
        "command": "dw-manager.repos.reinstall",
        "title": "Re-install All"
      },
      {
        "command": "dw-manager.repos.compile",
        "title": "Compile All"
      },
      {
        "command": "dw-manager.repos.scss",
        "title": "Compile SCSS"
      },
      {
        "command": "dw-manager.repos.js",
        "title": "Compile JS"
      },
      {
        "command": "dw-manager.repos.install-compile",
        "title": "Install and Compile All"
      },
      {
        "command": "dw-manager.repos.all",
        "title": "Update All Repositories"
      },
      {
        "command": "dw-manager.repos.changed",
        "title": "Update Changed Repositories"
      },
      {
        "command": "dw-manager.repos.configure",
        "title": "Configure Repository Tools"
      },
      {
        "command": "dw-manager.repos.state",
        "title": "Open Repository State"
      },
      {
        "command": "dw-manager.activities.start",
        "title": "Start / Re-run Activity",
        "icon": "$(play)"
      },
      {
        "command": "dw-manager.activities.stop",
        "title": "Stop Activity",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dw-manager.activities.refresh",
        "title": "Refresh Activities",
        "icon": "$(refresh)"
      },
      {
        "command": "dw-manager.activities.clearFinished",
        "title": "Clear Finished Activities",
        "icon": "$(clear-all)"
      },
      {
        "command": "dw-manager.activities.show",
        "title": "DW Manager: Show Activities",
        "icon": "$(list-tree)"
      },
      {
        "command": "dw-manager.enableUploadAll",
        "title": "DW Manager: Enable Upload and Upload All"
      },
      {
        "command": "dw-manager.enableSelectedUpload",
        "title": "DW Manager: Enable Upload for Selected Cartridges"
      },
      {
        "command": "dw-manager.enableSelectedUploadAll",
        "title": "DW Manager: Enable Upload and Upload Selected Cartridges"
      },
      {
        "command": "dw-manager.showUploadOutput",
        "title": "DW Manager: Show Upload Output",
        "icon": "$(output)"
      }
    ],
    "submenus": [
      {
        "id": "dw-manager.siteActions",
        "label": "Site Actions",
        "icon": "$(ellipsis)"
      },
      {
        "id": "dw-manager.repoActions",
        "label": "Repository Tools",
        "icon": "$(repo)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "dw-manager-repos",
        "required": [
          "siteId",
          "action"
        ],
        "properties": {
          "siteId": {
            "type": "string",
            "description": "Site UUID in dw-manager.json"
          },
          "action": {
            "type": "string",
            "description": "Repository action"
          },
          "runId": {
            "type": "string",
            "description": "Unique execution ID"
          },
          "siteName": {
            "type": "string"
          },
          "rootDir": {
            "type": "string"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --outfile=out/extension.js --external:vscode --external:@aws-sdk/client-s3",
    "test": "vitest run",
    "build:vsix": "node scripts/build-vsix.mjs",
    "build": "npm run build:vsix"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "unzipper": "^0.12.3"
  }
}
