{
  "name": "dw-manager",
  "displayName": "DW Manager",
  "description": "Easily switch and manage Salesforce sandbox environments, save workspace configurations, and export/import setups.",
  "version": "1.0.1",
  "publisher": "Ferb",
  "repository": {
    "type": "git",
    "url": "https://github.com/phat-trann/dw-manager"
  },
  "license": "MIT",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "keywords": [
    "salesforce",
    "sandbox",
    "environment",
    "manager",
    "dw",
    "credentials",
    "developer",
    "commerce cloud"
  ],
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "onCommand:dw-manager.selectSandbox",
    "onCommand:dw-manager.selectSandboxWithDetails",
    "onCommand:dw-manager.deleteSavedUsername",
    "onCommand:dw-manager.deleteSavedSandbox",
    "onCommand:dw-manager.exportSetup",
    "onCommand:dw-manager.importSetup",
    "onCommand:dw-manager.switchCodeVersion",
    "onCommand:dw-manager.deleteSandboxFromView",
    "onCommand:dwManagerView.refresh",
    "onCommand:dw-manager.addNewSandbox",
    "onCommand:dw-manager.changeCartridges",
    "onCommand:dw-manager.changeUser",
    "onCommand:dw-manager.editSandboxFromView",
    "onCommand:dw-manager.changeSavedPassword",
    "onCommand:dw-manager.enableProphetUpload",
    "onCommand:dw-manager.disableProphetUpload",
    "onView:dwManagerCartridgesView",
    "onCommand:dw-manager.refreshCartridges",
    "onCommand:dw-manager.openCartridge",
    "onCommand:dw-manager.revealCartridgeInExplorer",
    "onView:dwManagerLogsView",
    "onCommand:dw-manager.refreshLogs",
    "onCommand:dw-manager.tailLog",
    "onCommand:dw-manager.stopTailingLog"
  ],
  "contributes": {
    "submenus": [
      {
        "id": "dw-manager.sandboxActionsMenu",
        "label": "Sandbox Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dw-manager.addNewSandbox",
          "when": "view == dwManagerView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshCartridges",
          "when": "view == dwManagerCartridgesView",
          "group": "navigation"
        },
        {
          "command": "dw-manager.refreshLogs",
          "when": "view == dwManagerLogsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "submenu": "dw-manager.sandboxActionsMenu",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "inline"
        },
        {
          "command": "dw-manager.openCartridge",
          "when": "view == dwManagerCartridgesView && viewItem == cartridge",
          "group": "inline"
        },
        {
          "command": "dw-manager.revealCartridgeInExplorer",
          "when": "view == dwManagerCartridgesView && viewItem == cartridge",
          "group": "2_open"
        },
        {
          "command": "dw-manager.stopTailingLog",
          "when": "view == dwManagerLogsView && viewItem == logFileTailing",
          "group": "inline"
        }
      ],
      "dw-manager.sandboxActionsMenu": [
        {
          "command": "dw-manager.editSandboxFromView",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "1_edit@1"
        },
        {
          "command": "dw-manager.changeCartridges",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "1_edit@2"
        },
        {
          "command": "dw-manager.switchCodeVersion",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "1_edit@3"
        },
        {
          "command": "dw-manager.changeUser",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "1_edit@4"
        },
        {
          "command": "dw-manager.enableProphetUpload",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "2_prophet@1"
        },
        {
          "command": "dw-manager.disableProphetUpload",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "2_prophet@2"
        },
        {
          "command": "dw-manager.deleteSandboxFromView",
          "when": "view == dwManagerView && viewItem == sandbox",
          "group": "3_danger@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dwManager",
          "title": "DW Manager",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "dwManager": [
        {
          "id": "dwManagerView",
          "name": "Sandboxes"
        },
        {
          "id": "dwManagerCartridgesView",
          "name": "Cartridges"
        },
        {
          "id": "dwManagerLogsView",
          "name": "Logs"
        }
      ]
    },
    "commands": [
      {
        "command": "dw-manager.selectSandbox",
        "title": "Select Sandbox"
      },
      {
        "command": "dw-manager.selectSandboxWithDetails",
        "title": "Select Sandbox (Detailed)"
      },
      {
        "command": "dw-manager.editSandboxFromView",
        "title": "Edit Sandbox"
      },
      {
        "command": "dw-manager.changeCartridges",
        "title": "Change Cartridges"
      },
      {
        "command": "dw-manager.switchCodeVersion",
        "title": "Change Code Version"
      },
      {
        "command": "dw-manager.changeUser",
        "title": "Change User"
      },
      {
        "command": "dw-manager.deleteSandboxFromView",
        "title": "Delete Sandbox From View"
      },
      {
        "command": "dw-manager.deleteSavedSandbox",
        "title": "Delete Saved Sandbox"
      },
      {
        "command": "dw-manager.exportSetup",
        "title": "Export Sandbox Setup"
      },
      {
        "command": "dw-manager.importSetup",
        "title": "Import Sandbox Setup"
      },
      {
        "command": "dw-manager.addNewSandbox",
        "title": "Add New Sandbox"
      },
      {
        "command": "dw-manager.deleteSavedUsername",
        "title": "Delete Saved Username"
      },
      {
        "command": "dwManagerView.refresh",
        "title": "Refresh Sandbox View"
      },
      {
        "command": "dw-manager.changeSavedPassword",
        "title": "Change Saved Password"
      },
      {
        "command": "dw-manager.enableProphetUpload",
        "title": "DW Manager: Enable Upload (Prophet)"
      },
      {
        "command": "dw-manager.disableProphetUpload",
        "title": "DW Manager: Disable Upload (Prophet)"
      },
      {
        "command": "dw-manager.refreshCartridges",
        "title": "Refresh Cartridges"
      },
      {
        "command": "dw-manager.openCartridge",
        "title": "Open Cartridge"
      },
      {
        "command": "dw-manager.revealCartridgeInExplorer",
        "title": "Reveal Cartridge in Explorer"
      },
      {
        "command": "dw-manager.refreshLogs",
        "title": "Refresh Logs"
      },
      {
        "command": "dw-manager.tailLog",
        "title": "Tail Log"
      },
      {
        "command": "dw-manager.stopTailingLog",
        "title": "Stop Tailing"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --outfile=out/extension.js --external:vscode --external:@aws-sdk/client-s3",
    "test": "vitest run",
    "build:vsix": "node scripts/build-vsix.mjs",
    "build": "npm run build:vsix"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "unzipper": "^0.12.3"
  }
}
